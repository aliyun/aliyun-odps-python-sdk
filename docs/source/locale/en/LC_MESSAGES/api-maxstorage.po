#~ " the write schema."
#~ msgstr ""

#~ msgid ""
#~ "Delegates to :class:`~odps.maxstorage"
#~ ".read.record_reader.ArrowRecordReader` "
#~ "so that type conversion (datetime, "
#~ "timestamp, decimal, array, map, "
#~ "struct, …) is identical to the"
#~ " tunnel record reader.  BLOB columns"
#~ " — which the tunnel never supports"
#~ " — are handled specially: the "
#~ "Arrow ``binary`` value (the "
#~ "server-side blob reference) is stored"
#~ " as ``bytes`` without going "
#~ "through :func:`odps.types.validate_"
#~ "value`, which would reject the `"
#~ "`Blob`` type."
#~ msgstr ""

#~ msgid "write stream identifier."
#~ msgstr ""

#~ msgid ""
#~ "Converts Record -> Arrow batches.  When"
#~ " the underlying writer has "
#~ "``auto_upload_blobs=True``, BLOB columns are "
#~ "intercepted: file-like objects and raw"
#~ " ``bytes``/``bytearray`` are batch-uploaded "
#~ "by the record writer itself (via "
#~ "``stream_blob_batch``) and replaced with "
#~ "reference bytes before the batch reaches"
#~ " ``write_batch``.  File-like objects are"
#~ " streamed in chunks, never fully "
#~ "materialized.  ``str`` references pass through"
#~ " unchanged.  When ``auto_upload_blobs=False``, "
#~ "BLOB cells must already contain "
#~ "reference bytes."
#~ msgstr ""

#~ msgid ""
#~ "Accepts ``odps.types.Record``, ``list``, or "
#~ "``tuple``.  BLOB columns may contain: "
#~ "``bytes``/``bytearray`` (raw data, batched), "
#~ "file-like (read to bytes and closed),"
#~ " ``str`` (blob reference, passed through),"
#~ " ``None`` (null)."
#~ msgstr ""

