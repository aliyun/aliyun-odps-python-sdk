{
  "name": "pyodps",
  "description": "Front-end module of PyODPS",
  "version": "2.0.0",
  "main": "src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliyun/aliyun-odps-python-sdk.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build:nbextension && npm run build:labextension",
    "build:nbextension": "webpack --mode production --config webpack.config.js",
    "build:labextension": "node scripts/build-labextension.js",
    "dev:nbextension": "webpack --mode development --watch --config webpack.config.js",
    "dev:labextension": "node scripts/build-labextension.js --development --source-map",
    "clean": "rimraf labextension nbextension"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^4.0.0 || ^6.0.0",
    "@jupyter-widgets/controls": "^3.0.0 || ^5.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.0",
    "@jupyterlab/builder": "^4.0.0",
    "@jupyterlab/core-meta": "^4.6.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.0",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "jupyterlab": {
    "extension": "src/extension.js",
    "outputDir": "labextension",
    "webpackConfig": "webpack.labextension.config.js",
    "sharedPackages": {
      "@jupyter-widgets/base": {
        "bundled": false,
        "singleton": true
      },
      "@jupyter-widgets/controls": {
        "bundled": false,
        "singleton": true
      },
      "react": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "^17.0.0 || ^18.0.0"
      },
      "react-dom": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "^17.0.0 || ^18.0.0"
      }
    }
  }
}
